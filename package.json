{
  "name": "png-fx-tools",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": ">=10"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "^1.109.0",
    "esbuild": "^0.25.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build-worker.mjs && build-figma-plugin --typecheck --minify",
    "watch": "node scripts/watch.mjs"
  },
  "figma-plugin": {
    "editorType": ["figma"],
    "id": "1677704158330469128",
    "name": "Pixel FX",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": ["none"]
    }
  }
}
